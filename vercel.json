{
  "version": 2,
  "functions": {
    "api/**": {
      "includeFiles": "knowledge/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|favicon|.*\\..*).*)",
      "destination": "/dist/index.html"
    }
  ]
}
